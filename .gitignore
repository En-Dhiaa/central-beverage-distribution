# .gitignore

# Environment & Secrets
.env
.env.local
.env.*.local
*.key
*.pfx
*.pem

# .NET / C#
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
_ReSharper*/
*.DotSettings.user

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Storage & Backups (keep directory structure with .gitkeep)
storage/images/*
!storage/images/.gitkeep
storage/attachments/*
!storage/attachments/.gitkeep
storage/invoices/*
!storage/invoices/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
backups/*
!backups/.gitkeep

# Releases & Distribution Binaries
release/payload/
*.zip

# OS Generated
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

