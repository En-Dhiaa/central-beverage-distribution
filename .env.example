# Application Environment Configuration Example
# Copy this file to .env or configure in appsettings.Production.json

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# Database Configuration
# Options for DATABASE_PROVIDER: PostgreSQL | Sqlite
DATABASE_PROVIDER=Sqlite
DATABASE_CONNECTION_STRING=Data Source=storage/beverage_system.db

# Production PostgreSQL Example:
# DATABASE_PROVIDER=PostgreSQL
# DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=beverage_management;Username=postgres;Password=your_secure_password

# JWT Authentication
JWT_SECRET=super_secret_beverage_management_key_change_in_production_min_32_chars!
JWT_ISSUER=BeverageManagementServer
JWT_AUDIENCE=BeverageManagementClient
JWT_EXPIRATION_HOURS=24

# CORS
ALLOWED_ORIGINS=http://localhost:5173;http://localhost:3000;tauri://localhost

# File Storage
STORAGE_ROOT_PATH=storage
BACKUP_ROOT_PATH=backups

